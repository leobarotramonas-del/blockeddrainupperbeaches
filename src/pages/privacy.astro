---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---
<BaseLayout title="Privacy Policy" description="How Antons Blocked Drains Upper North Shore handles contact details, drainage job information, website data and privacy enquiries.">
  <article class="legal-page"><h1>Privacy Policy</h1><p>Last updated 19 October 2026.</p><h2>Who We Are</h2><p>Antons Blocked Drains Upper North Shore is provided by {site.operator}.</p><h2>Information You Provide</h2><p>If you call us, we may collect the contact and job information needed to respond, quote or provide drainage services. This may include your name, phone number, service address, access details and information about the blocked drain.</p><h2>How Information Is Used</h2><p>Information is used to respond to enquiries, arrange attendance, perform services, maintain business records and meet legal obligations. We do not claim to sell personal information.</p><h2>Website Data</h2><p>Hosting and analytics providers may process basic technical information needed to measure, deliver and protect the site. We do not intentionally send names, telephone numbers, service addresses or drainage-enquiry details to analytics services.</p><h2>Contact</h2><p>For privacy questions, call <a href={site.phoneHref}>{site.phoneDisplay}</a>.</p></article>
</BaseLayout>
