---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import FaqSection from '../../components/FaqSection.astro';
import { areas, services } from '../../data/site';
import { faqSchema } from '../../data/faqs';
export function getStaticPaths(){return areas.map(area=>({params:{slug:area.slug},props:{area}}));}
const {area}=Astro.props;
const relevant=services.filter(s=>area.focus.includes(s.slug));
const nearby=areas.filter(a=>area.neighbours.includes(a.slug));
const isNorthTurramurra=area.name==='North Turramurra';
const schema=[{'@type':'Service',name:`Blocked drain diagnosis and clearing in ${area.name}`,description:area.intro,serviceType:'Blocked drain diagnosis, clearing and repair',areaServed:{'@type':'Place',name:`${area.name}, NSW ${area.postcode}`,address:{'@type':'PostalAddress',addressLocality:area.name,postalCode:area.postcode,addressRegion:'NSW',addressCountry:'AU'}}},faqSchema(area.faqs)];
---
<BaseLayout title={area.title} description={area.description} schema={schema}>
<PageHero label={`${area.name} NSW ${area.postcode}`} title={area.title} intro={area.intro} image={area.image} imageAlt={area.imageAlt}/>
{isNorthTurramurra && <section class="section detail-grid north-turramurra-guide" aria-labelledby="north-turramurra-guide-title"><div><p class="page-label">Before you call</p><h2 id="north-turramurra-guide-title">Where is the water backing up?</h2><p>A slow sink or shower may involve one fixture. If several fixtures back up, a toilet gurgles or an outside gully overflows, tell us before using more water. If a pit fills during rain, note whether it drains afterwards. Those details help us distinguish a possible <a href="/services/sewer-drain-blockages/">sewer blockage</a> from a <a href="/services/stormwater-drains/">stormwater problem</a>.</p><p>Keep clear of wastewater, flooded pits and electrical hazards. Avoid adding chemical drain cleaner; let the plumber know if any has already been used.</p></div><div class="north-turramurra-guide__booking"><h3>Make the first call useful</h3><ul><li>Give the North Turramurra street address and whether the property is a house, unit or shared building.</li><li>Say which fixtures or pits are affected, when the problem began and whether it follows rain or water use.</li><li>Describe safe access through gates, stairs or a rear garden. For shared areas, have the building contact and keys ready.</li><li>Mention any previous clearing or camera report, and whether wastewater is overflowing now.</li></ul><p>We can discuss the likely assessment, safe access and next available response. A recurring fault may call for a <a href="/services/cctv-drain-inspections/">CCTV inspection</a>; a damaged section needs a separately scoped <a href="/services/drain-repairs/">repair</a>.</p><a class="call-button" href="tel:+61493824176"><span>Talk through the blockage</span><strong>0493 824 176</strong></a></div></section>}
<section class="section detail-grid"><div><h2>Property context and possible causes</h2><p>{area.localIssue}. These are possibilities, not a diagnosis of every property.</p><p>Hair and soap can restrict a bathroom waste; grease, wipes or foreign objects may lodge further along a branch. Roots need an entry point. Several affected fixtures, recurring blockages or an overflowing gully call for assessment of the connected line.</p></div><div><h2>Plan safe access</h2><p>{area.access}.</p><p class="local-note">{area.localOrientation}</p><p>Current coverage is confirmed by full street address. Call with symptoms and urgency to discuss the next available response.</p></div></section>
<section class="method-panel"><div><h2>From symptoms to evidence</h2><p>{area.diagnosis}</p><ol class="diagnostic-steps"><li>Describe timing, affected fixtures and any overflow.</li><li>Establish safe access and the affected section.</li><li>Clear using a method suited to obstruction and pipe condition.</li><li>Inspect recurring faults where appropriate, test flow and explain the findings.</li></ol></div><div><h2>Before the plumber arrives</h2><p>Stop using connected fixtures. Keep people and pets away from wastewater and avoid chemical cleaners. Tell the plumber if chemicals have already been used.</p><p>Do not enter pits, flooded basements or lift heavy covers. If water threatens electrical equipment, stay clear. Immediate danger needs the appropriate emergency service.</p><h3>Clearing and repair are separate</h3><p>{area.repair}</p></div></section>
<section class="section"><h2>Relevant methods and equipment</h2><div class="service-list">{relevant.map((service,index)=><a class="service-row" href={`/services/${service.slug}/`}><span>{index+1}</span><h3>{service.name}</h3><p>{service.summary}</p></a>)}</div><p class="local-note">Equipment follows actual access and pipe condition. <a href="/services/">Explore all eight services</a>.</p></section>
<FaqSection title={`${area.name}: practical drain questions`} items={area.faqs}/>
<section class="section related-section"><h2>Nearby locality guides</h2><div class="area-links">{nearby.map(a=><a href={`/service-areas/${a.slug}/`}>{a.name}<span>{a.postcode}</span></a>)}</div><a href="/service-areas/">View Upper North Shore coverage guidance</a></section>
<CtaBand title={`Talk through a blocked drain in ${area.name}`}/>
</BaseLayout>
<style>
  .north-turramurra-guide{align-items:start;border-bottom:1px solid var(--line)}
  .north-turramurra-guide .page-label{color:var(--blue);font-weight:700;letter-spacing:.06em;text-transform:uppercase}
  .north-turramurra-guide h2{max-width:15ch}
  .north-turramurra-guide__booking{background:#f2e6e5;padding:clamp(1.5rem,3vw,2.25rem)}
  .north-turramurra-guide__booking h3{font-size:1.45rem}
  .north-turramurra-guide__booking ul{margin:0 0 1.25rem;padding-left:1.25rem}
  .north-turramurra-guide__booking li{padding-left:.25rem;margin-bottom:.65rem}
  .north-turramurra-guide__booking .call-button{margin-top:.25rem}
  @media(max-width:720px){.north-turramurra-guide h2{max-width:none}.north-turramurra-guide__booking .call-button{width:100%;white-space:normal;flex-wrap:wrap}}
</style>
