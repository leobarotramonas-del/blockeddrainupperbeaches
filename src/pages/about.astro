---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import FaqSection from '../components/FaqSection.astro';
import { site } from '../data/site';
import { faqSchema, pageFaqs } from '../data/faqs';
---
<BaseLayout title="About Our Upper North Shore Blocked Drain Plumbers" description={`Meet the licensed team at ${site.name}. Learn how we diagnose blockages, inspect pipes and plan drain repairs.`} schema={faqSchema(pageFaqs.about)}>
  <PageHero label="About the Team" title="Upper North Shore drain plumbers focused on the cause." intro="Antons Blocked Drains Upper North Shore provides drain clearing, CCTV inspections, root removal and pipe repairs. We investigate recurring blockages and explain whether clearing or repairing the damaged line is needed." image="/images/team.webp" imageAlt="Three licensed plumbers standing beside a blue service vehicle" />
  <section class="section detail-grid">
    <div><h2>Licensed Blocked Drain Service in the Upper North Shore</h2><p>{site.name} serves local homes and properties with blocked-drain diagnosis, clearing and repairs. The service is operated by {site.operator}, with regulated work undertaken under NSW contractor licence {site.licence}.</p><p>Our drain plumbers handle blocked toilets, sewer and stormwater drains, CCTV inspections, water jetting and pipe repairs. We explain the findings, agree the scope and check flow after the work.</p></div>
    <div><h2>Professional Drain Diagnosis and Repair</h2><p>We start with symptoms, inspect accessible pipework and choose equipment for the line. High-pressure jetting may clear the obstruction; CCTV and electronic locating can show why it returned; targeted excavation can repair a failed section.</p><p>Explore our <a href="/services/">blocked drain services</a> or <a href="/contact/">call a drain plumber</a> to discuss the next step.</p></div>
  </section>
  <section class="operator-gallery"><ResponsiveImage src="/images/drain-camera-inspection.webp" alt="CCTV drain inspection equipment used to diagnose pipe condition" sizes="(max-width: 760px) calc(100vw - 32px), 46vw" loading="lazy" /><ResponsiveImage src="/images/blocked-drain-excavation.webp" alt="Drain plumber completing underground pipe repair work" sizes="(max-width: 760px) calc(100vw - 32px), 46vw" loading="lazy" /></section>
  <FaqSection title="About Our Drain Service" intro="Answers about experience, licensing, equipment and what customers can expect." items={pageFaqs.about} />
  <CtaBand />
</BaseLayout>
