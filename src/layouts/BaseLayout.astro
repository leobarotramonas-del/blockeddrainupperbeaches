---
import '@fontsource/barlow/latin-400.css';

import '@fontsource/barlow/latin-700.css';
import '@fontsource/saira-extra-condensed/latin-700.css';
import bodyFont from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';
import boldFont from '@fontsource/barlow/files/barlow-latin-700-normal.woff2?url';
import headingFont from '@fontsource/saira-extra-condensed/files/saira-extra-condensed-latin-700-normal.woff2?url';
import '../styles/global.css';


import Header from '../components/Header.astro';
import CallBar from '../components/CallBar.astro';
import Footer from '../components/Footer.astro';
import { site, services, areas } from '../data/site';
import { pageSchema } from '../data/schema';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  showFooter?: boolean;
  noindex?: boolean;
}

const { title, description, canonicalPath = Astro.url.pathname, schema, showFooter = true, noindex = false } = Astro.props;
const baseUrl = Astro.site!.href;
const allowIndexing = import.meta.env.PROD && import.meta.env.PUBLIC_ALLOW_INDEXING === 'true' && !noindex;
const enableAnalytics = import.meta.env.PROD && Boolean(site.analyticsId);
const canonical = new URL(canonicalPath, baseUrl).toString();
const socialImage = new URL('/images/blocked-drains.webp', baseUrl).href;
const pageTitle = title.includes(site.shortName) ? title : `${title} | ${site.shortName}`;
const parts=canonicalPath.split('/').filter(Boolean);
const labels: Record<string,string> = {'service-areas':'Service areas',services:'Services',about:'About',contact:'Contact',privacy:'Privacy',terms:'Terms','404':'Page not found'};
const structuredData = pageSchema(baseUrl, canonicalPath, pageTitle, description, schema);
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={allowIndexing ? 'index,follow,max-image-preview:large' : 'noindex,nofollow'} />
    <meta name="theme-color" content="#141414" />
    <meta name="geo.region" content="AU-NSW" />
    <meta name="geo.placename" content="The Upper North Shore, New South Wales" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={boldFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/png" sizes="150x150" href="/favicon-antons.png" />
    <link rel="apple-touch-icon" sizes="300x300" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Drain plumber using professional blocked-drain equipment" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Drain plumber using professional blocked-drain equipment" />
    {!noindex && <><link rel="canonical" href={canonical} /><link rel="alternate" hreflang="en-AU" href={canonical} /><link rel="alternate" hreflang="x-default" href={canonical} /></>}
    {enableAnalytics && (
      <>
        <script is:inline type="text/partytown" src={`https://www.googletagmanager.com/gtag/js?id=${site.analyticsId}`}></script>
        <script is:inline type="text/partytown" define:vars={{ analyticsId: site.analyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;
          gtag('js', new Date());
          gtag('config', analyticsId);
        </script>
      </>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to Main Content</a>
    <Header />
    <main id="main" class:list={{ 'inner-page': canonicalPath !== '/' }}>{parts.length > 0 && <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a>{parts.map((part,index)=><><span aria-hidden="true">/</span>{index===parts.length-1?<span aria-current="page">{labels[part]??services.find(s=>s.slug===part)?.name??areas.find(a=>a.slug===part)?.name??part.replaceAll('-',' ')}</span>:<a href={'/'+parts.slice(0,index+1).join('/')+'/'}>{labels[part]??part}</a>}</>)}</nav>}<slot /></main>
    {showFooter && <Footer />}
    <CallBar />
    {enableAnalytics && (
      <script is:inline>
        document.addEventListener('click', (event) => {
          const target = event.target;
          const link = target instanceof Element ? target.closest('a[href^="tel:"]') : null;
          if (!link || typeof window.gtag !== 'function') return;

          const callDetails = {
            method: 'phone',
            link_url: link.getAttribute('href'),
            link_text: link.textContent?.trim() || 'Call',
            page_location: window.location.href,
            transport_type: 'beacon',
          };

          // Dedicated event for reporting and key-event tracking of phone CTA clicks.
          window.gtag('event', 'phone_call_click', callDetails);

          // Retain GA4's recommended lead event for lead-acquisition reporting.
          window.gtag('event', 'generate_lead', callDetails);
        });
      </script>
    )}
  </body>
</html>
